// =============================================================================
// Fazl — PostgreSQL schema (migrated from MongoDB/Mongoose)
//
// Conventions, applied consistently across every model:
//
//  1. PRIMARY KEYS. Every model that had a Mongo ObjectId keeps that exact
//     24-character hex string as its primary key (`@db.VarChar(24)`). No UUIDs
//     are minted. This preserves every JWT `sub`, every S3 object key path,
//     every FCM payload id and all 807 `_id` references across the three
//     clients, and removes the need for an ID mapping table during migration.
//
//     VarChar(24) rather than Char(24): Postgres `char(n)` is blank-padded and
//     ignores trailing spaces when comparing, which silently masks id bugs in
//     raw SQL. VarChar has identical storage cost for fixed-width content.
//
//  2. NAMING. snake_case tables/columns via @@map/@map; camelCase in the Prisma
//     client so the TypeScript surface matches the existing Mongoose one.
//
//  3. MONEY. Always integer minor units (`Int`), never Float, never Decimal —
//     the existing wallet logic is already integer-correct end to end.
//
//  4. GEO. `latitude`/`longitude` are plain nullable Floats here; a PostGIS
//     `geography(Point,4326)` column plus its GiST index is added by manual
//     migration SQL and is invisible to Prisma. See prisma/migrations/.
//
//  5. DELETE RULES. Cascade only where the child is meaningless without its
//     parent. Restrict on every financial row and on categories in use.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The connection string reaches the CLI
// through prisma.config.ts and the runtime through the node-postgres driver
// adapter in src/prisma/prisma.service.ts. Both read DATABASE_URL.
datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// Every closed set that Mongoose declared with `enum:` becomes a real Postgres
// enum. Values that are not valid Prisma identifiers are @map'd to the exact
// string the existing data and the three clients already use.
// =============================================================================

/// Customer-facing roles only. Staff roles (super_admin/admin/subadmin) moved to
/// `AdminRole` on the `admins` table when staff were split out of `users`;
/// `moderator` became the `members` table. A row in `users` can never grant
/// admin-panel access.
enum UserRole {
  buyer
  seller
}

enum AdminPermissionPage {
  users
  shops
  listings
  services
  categories
  bookings
  broadcasts
  announcements
  feed
  reports
  email_logs    @map("email-logs")
  settings
  members
  wallet
  reviews
}

