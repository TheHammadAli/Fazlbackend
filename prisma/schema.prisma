// =============================================================================
// WALLET
// All amounts are integer minor units (PKR paisa). onDelete: Restrict on every
// financial row — history must never disappear because a parent was removed.
// =============================================================================

model Wallet {
  id         String  @id @db.VarChar(24)
  walletCode String? @unique @map("wallet_code")

  owner   User   @relation("WalletOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId String @map("owner_id") @db.VarChar(24)

  walletType WalletType @map("wallet_type")

  availableBalanceMinor Int @default(0) @map("available_balance_minor")
  pendingBalanceMinor   Int @default(0) @map("pending_balance_minor")

  /// Merchant-only lifetime running totals, denormalised for fast display.
  totalReceivedMinor  Int @default(0) @map("total_received_minor")
  totalWithdrawnMinor Int @default(0) @map("total_withdrawn_minor")

  isFrozen     Boolean   @default(false) @map("is_frozen")
  frozenReason String?   @map("frozen_reason")
  frozenAt     DateTime? @map("frozen_at") @db.Timestamptz(3)
  frozenBy     Admin?     @relation("WalletFrozenBy", fields: [frozenById], references: [id], onDelete: SetNull)
  frozenById   String?   @map("frozen_by") @db.VarChar(24)

  currency String @default("PKR") @db.VarChar(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ledgerEntries WalletLedgerEntry[]
  withdrawals   Withdrawal[]

  @@unique([ownerId, walletType])
  @@index([walletType, isFrozen])
  @@map("wallets")
}

/// The business/reporting record behind Transaction Management. Distinct from
/// WalletLedgerEntry: one transaction produces 0, 1 or 2 ledger entries. Deal/
/// discount/margin fields are a snapshot taken once at creation, never
/// re-derived from the live MerchantDeal later.
model WalletTransaction {
  id              String  @id @db.VarChar(24)
  transactionCode String? @unique @map("transaction_code")

  type WalletTransactionType

  user   User   @relation("WalletTransactionUser", fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.VarChar(24)

  merchant   User?   @relation("WalletTransactionMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId String? @map("merchant_id") @db.VarChar(24)

  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String? @map("order_id") @db.VarChar(24)

  originalAmountMinor           Int @default(0) @map("original_amount_minor")
  customerDiscountPercent       Int @default(0) @map("customer_discount_percent")
  customerDiscountAmountMinor   Int @default(0) @map("customer_discount_amount_minor")
  finalCustomerPaymentMinor     Int @default(0) @map("final_customer_payment_minor")
  merchantDealPercent           Int @default(0) @map("merchant_deal_percent")
  fazlMarginPercent             Int @default(0) @map("fazl_margin_percent")
  fazlMarginAmountMinor         Int @default(0) @map("fazl_margin_amount_minor")
  merchantSettlementAmountMinor Int @default(0) @map("merchant_settlement_amount_minor")

  dealSnapshot   MerchantDeal? @relation(fields: [dealSnapshotId], references: [id], onDelete: Restrict)
  dealSnapshotId String?       @map("deal_snapshot_id") @db.VarChar(24)

  paymentMethod WalletPaymentMethod @map("payment_method")

  /// Audit snapshots of who paid whom, not navigational relations — kept
  /// denormalised as (type, id) pairs exactly as in Mongo.
  senderRefType   WalletRefModel? @map("sender_ref_type")
  senderRefId     String?         @map("sender_ref_id") @db.VarChar(24)
  receiverRefType WalletRefModel? @map("receiver_ref_type")
  receiverRefId   String?         @map("receiver_ref_id") @db.VarChar(24)

  status       WalletTransactionStatus       @default(completed)
  refundStatus WalletTransactionRefundStatus @default(none) @map("refund_status")

  reason String?

  createdBy   Admin?   @relation("WalletTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String? @map("created_by") @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// `ledgerEntryIds: [ObjectId]` is dropped: the relationship was already
  /// stored on both sides, and WalletLedgerEntry.relatedTransactionId is the
  /// normalised single source of truth.
  ledgerEntries WalletLedgerEntry[]
  refunds       Refund[]
  withdrawals   Withdrawal[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([paymentMethod])
  @@index([createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

/// The append-only ledger core — every money movement creates one immutable
/// row. No service method ever updates or deletes a row; corrections are always
/// new rows. Opening/closing balances come from the same transaction that moved
/// the money, so they can never be based on stale data.
model WalletLedgerEntry {
  id         String  @id @db.VarChar(24)
  ledgerCode String? @unique @map("ledger_code")

  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletId String @map("wallet_id") @db.VarChar(24)

  direction   LedgerDirection
  balanceType LedgerBalanceType @map("balance_type")

  amountMinor         Int @map("amount_minor")
  openingBalanceMinor Int @map("opening_balance_minor")
  closingBalanceMinor Int @map("closing_balance_minor")

  relatedTransaction   WalletTransaction? @relation(fields: [relatedTransactionId], references: [id], onDelete: Restrict)
  relatedTransactionId String?            @map("related_transaction_id") @db.VarChar(24)

  relatedEntityType LedgerRelatedEntityType @map("related_entity_type")
  relatedEntityId   String?                 @map("related_entity_id") @db.VarChar(24)

  reason String?

  createdBy   Admin?   @relation("LedgerEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String? @map("created_by") @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([relatedTransactionId])
  @@index([relatedEntityType, relatedEntityId])
  @@map("wallet_ledger_entries")
}

/// Full withdrawal state machine. Fazl's own platform fee is always 0% —
/// externalFeeAmountMinor is informational (what the bank/provider took) and is
/// never subtracted from requestedAmountMinor by this system.
model Withdrawal {
  id             String  @id @db.VarChar(24)
  withdrawalCode String? @unique @map("withdrawal_code")

  merchant   User   @relation("WithdrawalMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId String @map("merchant_id") @db.VarChar(24)

  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletId String @map("wallet_id") @db.VarChar(24)

  requestedAmountMinor          Int @map("requested_amount_minor")
  availableBalanceSnapshotMinor Int @map("available_balance_snapshot_minor")

  withdrawalMethod WithdrawalMethod @map("withdrawal_method")

  /// Was an embedded `accountDetails` subdocument. Four fixed, always-present,
  /// financially auditable fields — flattened to columns.
  accountTitle  String  @map("account_title")
  accountNumber String  @map("account_number")
  bankName      String? @map("bank_name")
  iban          String?

  status WithdrawalStatus @default(pending)

  processingDate DateTime? @map("processing_date") @db.Timestamptz(3)
  completedDate  DateTime? @map("completed_date") @db.Timestamptz(3)

  transaction   WalletTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  transactionId String?            @map("transaction_id") @db.VarChar(24)

  platformFeePercent     Int     @default(0) @map("platform_fee_percent")
  externalFeeAmountMinor Int?    @map("external_fee_amount_minor")
  externalFeeNote        String? @map("external_fee_note")
  rejectionReason        String? @map("rejection_reason")
  cancellationReason     String? @map("cancellation_reason")

  createdBy   Admin   @relation("WithdrawalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String @map("created_by") @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([walletId])
  @@map("withdrawals")
}

/// One-step refund workflow: creating a refund immediately posts the crediting
/// ledger entry and marks it completed, or it is rejected with a reason. The
/// admin action log is derived from WalletAuditLog (targetType "Refund") rather
/// than duplicated here.
model Refund {
  id         String  @id @db.VarChar(24)
  refundCode String? @unique @map("refund_code")

  originalTransaction   WalletTransaction @relation(fields: [originalTransactionId], references: [id], onDelete: Restrict)
  originalTransactionId String            @map("original_transaction_id") @db.VarChar(24)

  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String? @map("order_id") @db.VarChar(24)

  customer   User   @relation("RefundCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  customerId String @map("customer_id") @db.VarChar(24)

  merchant   User?   @relation("RefundMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId String? @map("merchant_id") @db.VarChar(24)

  refundAmountMinor Int    @map("refund_amount_minor")
  refundReason      String @map("refund_reason")

  refundStatus RefundStatus @default(pending) @map("refund_status")

  /// As on WalletTransaction, `ledgerEntryIds: [ObjectId]` is dropped in favour
  /// of the WalletLedgerEntry.relatedEntityType/relatedEntityId back-reference.
  rejectionReason String? @map("rejection_reason")

  createdBy   Admin   @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String @map("created_by") @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([refundStatus, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([originalTransactionId])
  @@map("refunds")
}

/// Append-only version history of a merchant's commercial deal. A row is never
/// updated in place — changing terms closes the active row (sets effectiveTo)
/// and inserts a new one. `merchantDealPercent` is always server-computed as
/// customerDiscountPercent + fazlMarginPercent.
///
/// NOTE: the "at most one active deal per merchant" rule was a Mongo partial
/// unique index. Prisma cannot express partial indexes, so it is created by
/// hand in the migration SQL:
///   CREATE UNIQUE INDEX merchant_deals_active_uniq
///     ON merchant_deals (merchant_id) WHERE effective_to IS NULL;
model MerchantDeal {
  id String @id @db.VarChar(24)

  merchant   User   @relation("MerchantDealMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId String @map("merchant_id") @db.VarChar(24)

  customerDiscountPercent Int @map("customer_discount_percent")
  fazlMarginPercent       Int @map("fazl_margin_percent")
  merchantDealPercent     Int @map("merchant_deal_percent")

  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(3)

  createdBy   Admin   @relation("MerchantDealCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String @map("created_by") @db.VarChar(24)

  reason String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactions WalletTransaction[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("merchant_deals")
}

/// Singleton wallet-wide configuration. Fixed string primary key
/// ("wallet-settings"), mirroring SiteSettings and Counter.
model WalletSettings {
  id String @id @db.VarChar(64)

  minTopUpAmountMinor        Int @default(10000) @map("min_top_up_amount_minor")
  maxTopUpAmountMinor        Int @default(100000000) @map("max_top_up_amount_minor")
  minWithdrawalAmountMinor   Int @default(50000) @map("min_withdrawal_amount_minor")
  maxWithdrawalAmountMinor   Int @default(100000000) @map("max_withdrawal_amount_minor")
  dailyTransactionLimitMinor Int @default(500000000) @map("daily_transaction_limit_minor")

  walletStatus     Boolean @default(true) @map("wallet_status")
  withdrawalStatus Boolean @default(true) @map("withdrawal_status")

  updatedBy   Admin?   @relation("WalletSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by") @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("wallet_settings")
}

/// Dedicated audit trail for every wallet-admin action. Append-only. Kept
/// separate from ActivityLog, which has no structured oldValue/newValue/reason
/// fields and closed enums that do not cover wallet concepts.
model WalletAuditLog {
  id      String  @id @db.VarChar(24)
  logCode String? @unique @map("log_code")

  admin   Admin   @relation("WalletAuditLogAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  adminId String @map("admin_id") @db.VarChar(24)

  action     WalletAuditAction
  targetType WalletAuditTargetType @map("target_type")

  /// Plain string, never an ObjectId FK: most targets are real documents, but
  /// WalletSettings uses the fixed singleton id "wallet-settings".
  targetId String @map("target_id") @db.VarChar(64)

  subjectUser   User?   @relation("WalletAuditLogSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  subjectUserId String? @map("subject_user_id") @db.VarChar(24)

  transactionId String? @map("transaction_id") @db.VarChar(24)

  /// Arbitrary before/after snapshots — JSONB is the correct model here, not a
  /// compromise.
  oldValue Json? @map("old_value")
  newValue Json? @map("new_value")

  reason    String?
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectUserId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("wallet_audit_logs")
}
