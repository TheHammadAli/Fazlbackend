// =============================================================================
// IDENTITY
// =============================================================================

model User {
  id             String     @id @db.VarChar(24)
  userCode       String?    @unique @map("user_code")
  name           String?
  email          String     @unique
  // `select: false` in Mongoose silently kept these out of every response.
  // Prisma has no equivalent — every read path must use the shared
  // `userPublicSelect` constant instead. See src/users/user-select.ts.
  password       String?
  roles          UserRole[]
  phone          String?    @unique
  latitude       Float?
  longitude      Float?
  image          String?    @default("default-avatar.png")
  address        String?
  refreshToken   String?    @map("refresh_token")

  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires") @db.Timestamptz(3)
  provider             String?

  // Legacy single-device token, kept so devices registered before multi-device
  // support still receive pushes; new registrations append to fcmTokens.
  fcmToken  String?  @map("fcm_token")
  fcmTokens String[] @default([]) @map("fcm_tokens")

  isDisabled Boolean   @default(false) @map("is_disabled")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // NOTE: users.schema.ts also declares `language` and `isVerified` as plain
  // class properties with no @Prop decorator, so Mongoose never persisted them
  // and no column exists to migrate. They are deliberately omitted here.

  shops    Shop[]
  products Product[]
  services Service[]

  ordersAsBuyer Order[] @relation("OrderBuyer")
  ordersAsOwner Order[] @relation("OrderUserOwner")

  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messagesSent          Message[]      @relation("MessageSender")
  messagesReceived      Message[]      @relation("MessageReceiver")

  productOffersMade     ProductOffer[] @relation("ProductOfferOfferer")
  productOffersReceived ProductOffer[] @relation("ProductOfferSeller")

  broadcasts                Broadcast[]        @relation("BroadcastBuyer")
  broadcastThreadsAsBuyer   BroadcastThread[]  @relation("BroadcastThreadBuyer")
  broadcastThreadsAsSeller  BroadcastThread[]  @relation("BroadcastThreadSeller")
  broadcastMessagesSent     BroadcastMessage[] @relation("BroadcastMessageSender")
  broadcastMessagesReceived BroadcastMessage[] @relation("BroadcastMessageReceiver")
  broadcastOffersMade       BroadcastOffer[]   @relation("BroadcastOfferOfferer")
  broadcastOffersReceived   BroadcastOffer[]   @relation("BroadcastOfferCreator")

  likes   Like[]
  shares  Share[]
  reviews Review[]

  reportsFiled Report[] @relation("ReportReporter")

  notifications     Notification[]
  announcementViews AnnouncementView[]

  categoryRequestsMade CategoryRequest[] @relation("CategoryRequestRequestedBy")

  serviceRequestsAsCustomer ServiceRequest[] @relation("ServiceRequestCustomer")
  serviceRequestsAsProvider ServiceRequest[] @relation("ServiceRequestProvider")

  wallets Wallet[] @relation("WalletOwner")

  walletTransactionsAsUser     WalletTransaction[] @relation("WalletTransactionUser")
  walletTransactionsAsMerchant WalletTransaction[] @relation("WalletTransactionMerchant")

  withdrawalsAsMerchant Withdrawal[] @relation("WithdrawalMerchant")

  refundsAsCustomer Refund[] @relation("RefundCustomer")
  refundsAsMerchant Refund[] @relation("RefundMerchant")

  merchantDeals MerchantDeal[] @relation("MerchantDealMerchant")

  walletAuditLogsAsSubject WalletAuditLog[] @relation("WalletAuditLogSubject")

  productViews          ProductView[]
  productContactClicks  ProductContactClick[]
  productWhatsappClicks ProductWhatsappClick[]
  serviceViews          ServiceView[]
  serviceContactClicks  ServiceContactClick[]
  serviceWhatsappClicks ServiceWhatsappClick[]
  shopViews             ShopView[]
  shopProductViews      ShopProductView[]
  shopContactClicks     ShopContactClick[]
  shopWhatsappClicks    ShopWhatsappClick[]

  @@index([email])
  @@index([isDisabled])
  @@map("users")
}

// =============================================================================
// STAFF IDENTITY
//
// Staff live in their own tables, entirely separate from `users`. A person who
// works the admin panel and a person who shops on the app are different rows in
// different tables even when they share an email address — nothing about a
// customer account grants panel access, and nothing about a staff account
// appears in customer-facing queries.
//
// super_admin / admin / subadmin share every column and every code path, so
// they are one table separated by `role`. Members (the moderators tasks get
// assigned to) are a distinct table because they are created *by* an admin and
// can only ever touch tasks.
// =============================================================================

enum AdminRole {
  super_admin
  admin
  subadmin
}

model Admin {
  id        String @id @db.VarChar(24)
  adminCode String @unique @map("admin_code")

  name  String
  email String @unique
  /// Never selected into a response — see src/admins/admin-select.ts.
  password String

  role AdminRole
  /// Contact detail only, deliberately not unique: two staff sharing an office
  /// line is normal, and uniqueness here bought nothing.
  phone   String?
  address String?
  image   String? @default("default-avatar.png")

  isDisabled   Boolean   @default(false) @map("is_disabled")
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(3)
  refreshToken String?   @map("refresh_token")

  /// Which admin created this one. Null for the seeded first super_admin, which
  /// no one created, and for any admin whose creator row is later removed.
  createdBy   Admin?  @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String? @map("created_by") @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  adminsCreated Admin[]           @relation("AdminCreatedBy")
  permissions   AdminPermission[]
  members       Member[]          @relation("MemberCreatedBy")

  reportsClosed    Report[] @relation("ReportClosedBy")
  reportsResponded Report[] @relation("ReportRespondedBy")

  announcements            Announcement[]    @relation("AnnouncementCreatedBy")
  categoryRequestsReviewed CategoryRequest[] @relation("CategoryRequestReviewedBy")

  tasksCreated Task[]        @relation("TaskCreatedBy")
  activityLogs ActivityLog[] @relation("ActivityLogAdminActor")

  walletsFrozen             Wallet[]            @relation("WalletFrozenBy")
  walletTransactionsCreated WalletTransaction[] @relation("WalletTransactionCreatedBy")
  ledgerEntriesCreated      WalletLedgerEntry[] @relation("LedgerEntryCreatedBy")
  withdrawalsCreated        Withdrawal[]        @relation("WithdrawalCreatedBy")
  refundsCreated            Refund[]            @relation("RefundCreatedBy")
  merchantDealsCreated      MerchantDeal[]      @relation("MerchantDealCreatedBy")
  walletSettingsUpdated     WalletSettings[]    @relation("WalletSettingsUpdatedBy")
  walletAuditLogs           WalletAuditLog[]    @relation("WalletAuditLogAdmin")

  @@index([email])
  @@index([role])
  @@index([isDisabled])
  @@index([createdById])
  @@map("admins")
}

model Member {
  id         String @id @db.VarChar(24)
  memberCode String @unique @map("member_code")

  name  String
  email String @unique
  /// Never selected into a response — see src/admins/admin-select.ts.
  password String

  phone   String?
  address String?
  image   String? @default("default-avatar.png")

  isDisabled   Boolean   @default(false) @map("is_disabled")
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(3)
  refreshToken String?   @map("refresh_token")

  /// Restrict, not Cascade: an admin leaving must not silently delete the
  /// members they onboarded along with their task history.
  createdBy   Admin  @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String @map("created_by") @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  taskAssignments TaskAssignee[]
  taskSubmissions TaskSubmission[]
  activityLogs    ActivityLog[]    @relation("ActivityLogMemberActor")

  @@index([email])
  @@index([isDisabled])
  @@index([createdById])
  @@map("members")
}

/// Per-page admin panel permissions. Was `user_permissions` hanging off `users`;
/// now hangs off `admins`, since only staff have permissions at all.
/// Members are not listed here — their access is fixed to the task endpoints.
model AdminPermission {
  id      String              @id @default(uuid())
  admin   Admin               @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId String              @map("admin_id") @db.VarChar(24)
  page    AdminPermissionPage
  actions AdminAction[]       @default([])

  @@unique([adminId, page])
  @@index([adminId])
  @@map("admin_permissions")
}

model Otp {
  id          String    @id @db.VarChar(24)
  phoneNumber String?   @map("phone_number")
  email       String?
  code        String
  type        String    @default("phone")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)

  @@index([email])
  @@index([phoneNumber])
  @@index([expiresAt])
  @@map("otps")
}

// =============================================================================
// CATALOGUE
// =============================================================================

model Category {
  /// Locale-keyed map, e.g. { "en": "Electronics", "ur": "..." }.
  /// Was a Mongoose Map<string,string>; read and written whole, never queried
  /// by inner key, so JSONB is the correct shape rather than a locale table.
  name        Json
  description Json?

  id String @id @db.VarChar(24)

  /// { en: [{name, values[], isOptional, allowCustomValue, allowMultiple}], ur: [...] }
  /// Deeply irregular and always read whole — JSONB, not a parameters table.
  parameters Json? @default("{\"en\":[],\"ur\":[]}")

  sortNumber Int          @default(0) @map("sort_number")
  isDisabled Boolean      @default(false) @map("is_disabled")
  icon       String?
  type       CategoryType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products       Product[]
  services       Service[]
  shopsPrimary   Shop[]         @relation("ShopCategory")
  shopsSecondary Shop[]         @relation("ShopSubcategory")
  broadcasts     Broadcast[]
  announcements  Announcement[]

  @@index([type, isDisabled])
  @@index([sortNumber])
  @@map("categories")
}

model CategoryRequest {
  id            String                @id @db.VarChar(24)
  name          String
  description   String?
  requestedBy   User                  @relation("CategoryRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  requestedById String                @map("requested_by") @db.VarChar(24)
  status        CategoryRequestStatus @default(pending)
  reviewedBy    Admin?                 @relation("CategoryRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById  String?               @map("reviewed_by") @db.VarChar(24)
  adminComment  String?               @map("admin_comment")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt    DateTime?             @map("reviewed_at") @db.Timestamptz(3)

  @@index([status])
  @@index([requestedById])
  @@map("category_requests")
}

model Shop {
  id       String  @id @db.VarChar(24)
  shopCode String? @unique @map("shop_code")

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @map("owner_id") @db.VarChar(24)

  title       String
  image       String?
  banner      String?
  address     String
  description String

  category   Category @relation("ShopCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String   @map("category_id") @db.VarChar(24)

  subcategory   Category? @relation("ShopSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  subcategoryId String?   @map("subcategory_id") @db.VarChar(24)

  marketName   String? @map("market_name")
  area         String
  city         String
  contact      String
  openingHours String? @map("opening_hours")

  isDisabled Boolean @default(false) @map("is_disabled")

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products       Product[]
  ordersAsOwner  Order[]             @relation("OrderShopOwner")
  views          ShopView[]
  productViews   ShopProductView[]
  contactClicks  ShopContactClick[]
  whatsappClicks ShopWhatsappClick[]
  promotions     Promotion[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([city, area])
  @@index([isDisabled])
  @@map("shops")
}

model Product {
  id          String  @id @db.VarChar(24)
  listingCode String? @unique @map("listing_code")
  /// Sequential display id (e.g. VID-000001), assigned only when this product
  /// carries a video (i.e. appears in the feed).
  videoCode   String? @unique @map("video_code")

  shop   Shop?   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String? @map("shop_id") @db.VarChar(24)

  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String? @map("owner_id") @db.VarChar(24)

  title       String
  description String?
  price       Int
  type        ProductType

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String   @map("category_id") @db.VarChar(24)

  images String[] @default([])
  video  String?

  latitude  Float?
  longitude Float?

  /// [{ name, variants[] }] — only ever rendered, never queried by inner field.
  /// Searching goes through `searchableTags` instead.
  parameters Json? @default("[]")

  /// Denormalised from `parameters` by the two ProductSchema pre-hooks in
  /// Mongoose. Prisma has no equivalent middleware, so ProductsService.create()
  /// and .update() now compute this explicitly.
  searchableTags String[] @default([]) @map("searchable_tags")

  isDeleted   Boolean @default(false) @map("is_deleted")
  isDisabled  Boolean @default(false) @map("is_disabled")
  /// True for a lightweight "just a video" shop post (no real category/price).
  isVideoPost Boolean @default(false) @map("is_video_post")

  address String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders         Order[]
  offers         ProductOffer[]
  views          ProductView[]
  contactClicks  ProductContactClick[]
  whatsappClicks ProductWhatsappClick[]
  promotions     Promotion[]

  @@index([shopId, isVideoPost, isDeleted, isDisabled])
  @@index([categoryId])
  @@index([ownerId])
  @@index([createdAt(sort: Desc)])
  @@index([searchableTags], type: Gin)
  @@map("products")
}

model Service {
  id          String  @id @db.VarChar(24)
  serviceCode String? @unique @map("service_code")

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @map("owner_id") @db.VarChar(24)

  title       String
  description String?
  price       Int?

  paymentType         ServicePaymentType @default(fixed) @map("payment_type")
  requiresAppointment Boolean            @default(true) @map("requires_appointment")

  images String[] @default([])
  video  String?

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String   @map("category_id") @db.VarChar(24)

  latitude  Float?
  longitude Float?

  parameters Json? @default("[]")

  isDeleted  Boolean @default(false) @map("is_deleted")
  isDisabled Boolean @default(false) @map("is_disabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests       ServiceRequest[]
  views          ServiceView[]
  contactClicks  ServiceContactClick[]
  whatsappClicks ServiceWhatsappClick[]
  promotions     Promotion[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([isDeleted, isDisabled])
  @@index([createdAt(sort: Desc)])
  @@map("services")
}

// =============================================================================
// COMMERCE
// =============================================================================

/// `owner` + `ownerModel` was a Mongoose refPath pointing at either Shop or
/// User. Split into two nullable typed FKs with a CHECK constraint (added in
/// manual migration SQL) asserting exactly one is set — orders are financially
/// significant and deserve real referential integrity.
model Order {
  id String @id @db.VarChar(24)

  buyer   User   @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerId String @map("buyer_id") @db.VarChar(24)

  ownerModel OwnerModel @map("owner_model")

  shopOwner   Shop?   @relation("OrderShopOwner", fields: [shopOwnerId], references: [id], onDelete: Restrict)
  shopOwnerId String? @map("shop_owner_id") @db.VarChar(24)

  userOwner   User?   @relation("OrderUserOwner", fields: [userOwnerId], references: [id], onDelete: Restrict)
  userOwnerId String? @map("user_owner_id") @db.VarChar(24)

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String  @map("product_id") @db.VarChar(24)

  deliveryOption DeliveryOption   @map("delivery_option")
  status         OrderStatus      @default(pending)
  paymentType    OrderPaymentType @default(cashonDelivery) @map("payment_type")

  amount   Int
  quantity Int

  /// Purchase-time snapshot of arbitrary product options.
  variant Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  walletTransactions WalletTransaction[]
  refunds            Refund[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([shopOwnerId])
  @@index([userOwnerId])
  @@index([productId])
  @@index([status])
  @@map("orders")
}

model ProductOffer {
  id String @id @db.VarChar(24)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.VarChar(24)

  offerer   User   @relation("ProductOfferOfferer", fields: [offererId], references: [id], onDelete: Cascade)
  offererId String @map("offerer_id") @db.VarChar(24)

  seller   User   @relation("ProductOfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String @map("seller_id") @db.VarChar(24)

  price       Int?
  message     String             @db.VarChar(1000)
  status      ProductOfferStatus @default(pending)
  respondedAt DateTime?          @map("responded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([productId, offererId])
  @@index([sellerId, status, updatedAt(sort: Desc)])
  @@index([offererId, updatedAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("product_offers")
}

model ServiceRequest {
  id      String  @id @db.VarChar(24)
  jobCode String? @unique @map("job_code")

  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String  @map("service_id") @db.VarChar(24)

  customer   User   @relation("ServiceRequestCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  customerId String @map("customer_id") @db.VarChar(24)

  provider   User   @relation("ServiceRequestProvider", fields: [providerId], references: [id], onDelete: Restrict)
  providerId String @map("provider_id") @db.VarChar(24)

  requestedDateTime DateTime  @map("requested_date_time") @db.Timestamptz(3)
  proposedDateTime  DateTime? @map("proposed_date_time") @db.Timestamptz(3)

  status    ServiceRequestStatus @default(pending)
  jobStatus JobStatus            @default(not_started) @map("job_status")

  message     String?
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId, createdAt(sort: Desc)])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([serviceId])
  @@index([status])
  @@map("service_requests")
}

model Subscription {
  id             String                  @id @db.VarChar(24)
  targetType     SubscriptionTargetType  @map("target_type")
  name           String
  price          Int
  durationInDays Int                     @map("duration_in_days")
  screenType     SubscriptionScreenType? @default(listing) @map("screen_type")
  description    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  promotions Promotion[]

  @@map("subscriptions")
}

/// `targetId` + `targetType` was a Mongoose refPath over Product | Shop |
/// Service. Split into three nullable typed FKs with a CHECK constraint (manual
/// migration SQL) — promotions are queried by target constantly and there are
/// only three of them.
model Promotion {
  id String @id @db.VarChar(24)

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  subscriptionId String       @map("subscription_id") @db.VarChar(24)

  targetType PromotionTargetType @map("target_type")

  // Exactly one of these three is set, asserted by a CHECK constraint added in
  // the 20260906000001_postgis_and_constraints migration.
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?  @map("product_id") @db.VarChar(24)

  shop   Shop?   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String? @map("shop_id") @db.VarChar(24)

  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String?  @map("service_id") @db.VarChar(24)

  startDate DateTime        @map("start_date") @db.Timestamptz(3)
  endDate   DateTime        @map("end_date") @db.Timestamptz(3)
  status    PromotionStatus @default(active)

  isAutoRenew Boolean @default(false) @map("is_auto_renew")
  isInFeed    Boolean @default(false) @map("is_in_feed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([targetType, status])
  @@index([productId])
  @@index([shopId])
  @@index([serviceId])
  @@index([status, endDate])
  @@map("promotions")
}

// =============================================================================
// CHAT
// =============================================================================

model Conversation {
  id String @id @db.VarChar(24)

  buyer   User   @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId String @map("buyer_id") @db.VarChar(24)

  seller   User   @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String @map("seller_id") @db.VarChar(24)

  status        ConversationStatus @default(open)
  lastMessageAt DateTime?          @map("last_message_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages Message[]

  @@unique([buyerId, sellerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id String @id @db.VarChar(24)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversation_id") @db.VarChar(24)

  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  senderId String @map("sender_id") @db.VarChar(24)

  receiver   User   @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  receiverId String @map("receiver_id") @db.VarChar(24)

  text String?

  /// Only set on system-generated messages (offer accept/decline/expiry) where
  /// what happened reads differently for each participant. The sender's own
  /// client renders this instead of `text`.
  senderText String? @map("sender_text")

  imageUrl      String? @map("image_url")
  audioUrl      String? @map("audio_url")
  audioDuration Int?    @map("audio_duration")

  /// Kept in sync with `status` (status == read <=> read == true) so every
  /// existing unread-count query that filters on `read` keeps working.
  read        Boolean       @default(false)
  status      MessageStatus @default(sent)
  deliveredAt DateTime?     @map("delivered_at") @db.Timestamptz(3)
  readAt      DateTime?     @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Drives the offline delivery flush on socket connect.
  @@index([receiverId, status])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([receiverId, read])
  @@map("messages")
}

// =============================================================================
// BROADCAST
// =============================================================================

model Broadcast {
  id            String  @id @db.VarChar(24)
  broadcastCode String? @unique @map("broadcast_code")

  buyer   User   @relation("BroadcastBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId String @map("buyer_id") @db.VarChar(24)

  message String
  address String?
  purpose BroadcastPurpose

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String?   @map("category_id") @db.VarChar(24)

  /// Search radius in kilometres.
  radius Int

  latitude  Float?
  longitude Float?

  type           ItemType
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz(3)
  lastResponseAt DateTime?       @map("last_response_at") @db.Timestamptz(3)
  status         BroadcastStatus @default(open)
  isDeleted      Boolean         @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  threads  BroadcastThread[]
  messages BroadcastMessage[]
  offers   BroadcastOffer[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([status, isDeleted])
  @@map("broadcasts")
}

model BroadcastThread {
  id String @id @db.VarChar(24)

  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastId String    @map("broadcast_id") @db.VarChar(24)

  buyer   User   @relation("BroadcastThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId String @map("buyer_id") @db.VarChar(24)

  seller   User   @relation("BroadcastThreadSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String @map("seller_id") @db.VarChar(24)

  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages BroadcastMessage[]
  offer    BroadcastOffer?

  @@unique([broadcastId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("broadcast_threads")
}

model BroadcastMessage {
  id String @id @db.VarChar(24)

  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastId String    @map("broadcast_id") @db.VarChar(24)

  thread   BroadcastThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String          @map("thread_id") @db.VarChar(24)

  sender   User   @relation("BroadcastMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  senderId String @map("sender_id") @db.VarChar(24)

  receiver   User   @relation("BroadcastMessageReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  receiverId String @map("receiver_id") @db.VarChar(24)

  message       String?
  imageUrls     String[] @default([]) @map("image_urls")
  audioUrl      String?  @map("audio_url")
  audioDuration Int?     @map("audio_duration")
  isRead        Boolean  @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([threadId, createdAt(sort: Desc)])
  @@index([receiverId, isRead])
  @@map("broadcast_messages")
}

model BroadcastOffer {
  id String @id @db.VarChar(24)

  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastId String    @map("broadcast_id") @db.VarChar(24)

  /// One offer per thread — was a @Prop({ unique: true }) in Mongoose.
  thread   BroadcastThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String          @unique @map("thread_id") @db.VarChar(24)

  offerer   User   @relation("BroadcastOfferOfferer", fields: [offererId], references: [id], onDelete: Cascade)
  offererId String @map("offerer_id") @db.VarChar(24)

  creator   User   @relation("BroadcastOfferCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String @map("creator_id") @db.VarChar(24)

  price       Int?
  message     String               @db.VarChar(1000)
  status      BroadcastOfferStatus @default(pending)
  respondedAt DateTime?            @map("responded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([creatorId, status, updatedAt(sort: Desc)])
  @@map("broadcast_offers")
}

// =============================================================================
// SOCIAL
// `itemId` + `itemType` stays denormalised here rather than splitting into
// typed FKs: these are high-write, low-integrity-risk rows, and splitting them
// would multiply every analytics query that currently works on one table.
// =============================================================================

model Like {
  id String @id @db.VarChar(24)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.VarChar(24)

  itemId     String     @map("item_id") @db.VarChar(24)
  itemType   ItemType   @map("item_type")
  ownerModel OwnerModel @map("owner_model")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, itemId, itemType])
  @@index([itemId, itemType])
  @@map("likes")
}

model Share {
  id String @id @db.VarChar(24)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.VarChar(24)

  itemId   String   @map("item_id") @db.VarChar(24)
  itemType ItemType @map("item_type")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, itemId, itemType])
  @@index([itemId, itemType])
  @@map("shares")
}

model Review {
  id String @id @db.VarChar(24)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.VarChar(24)

  itemId   String   @map("item_id") @db.VarChar(24)
  itemType ItemType @map("item_type")

  /// When set, scopes the review to one booking rather than the item overall,
  /// so a user can review each booking of the same service separately.
  requestId String? @map("request_id") @db.VarChar(24)

  rating    Int
  comment   String? @db.VarChar(1000)
  isFlagged Boolean @default(false) @map("is_flagged")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([itemId, itemType])
  @@index([userId])
  @@index([requestId])
  @@map("reviews")
}

/// Polymorphic over four entity types, admin-only reads, low volume — kept
/// denormalised. The four-way entity resolution moves to a raw SQL LEFT JOIN
/// (src/prisma/repositories/report.repository.ts), which also replaces the one
/// raw-driver call that existed in reports.service.ts.
model Report {
  id         String  @id @db.VarChar(24)
  reportCode String? @unique @map("report_code")

  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String @map("reporter_id") @db.VarChar(24)

  entityId   String           @map("entity_id") @db.VarChar(24)
  entityType ReportEntityType @map("entity_type")

  reason  ReportReason
  details String       @db.VarChar(1000)

  status         ReportStatus @default(open)
  contentRemoved Boolean      @default(false) @map("content_removed")

  closedBy   Admin?     @relation("ReportClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedById String?   @map("closed_by") @db.VarChar(24)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(3)

  adminResponse String?   @map("admin_response") @db.VarChar(1000)
  respondedBy   Admin?     @relation("ReportRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedById String?   @map("responded_by") @db.VarChar(24)
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([reporterId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([entityId, entityType])
  @@map("reports")
}

// =============================================================================
// PLATFORM
// =============================================================================

model Notification {
  id String @id @db.VarChar(24)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.VarChar(24)

  type    NotificationType
  message String

  /// Free-form per notification type; the shape differs across all nine types.
  metadata Json? @default("{}")
  payload  Json? @default("{}")

  read Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model Announcement {
  id               String  @id @db.VarChar(24)
  announcementCode String? @unique @map("announcement_code")

  title   String
  message String
  image   String?
  video   String?

  /// Roles to notify, e.g. ["buyer","seller"]. Empty means all users.
  targetAudience String[] @default([]) @map("target_audience")

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?   @map("category_id") @db.VarChar(24)

  location       String?
  ctaLabel       String?   @map("cta_label")
  ctaDestination String?   @map("cta_destination")
  scheduledAt    DateTime? @map("scheduled_at") @db.Timestamptz(3)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)

  priority AnnouncementPriority? @default(medium)
  status   AnnouncementStatus    @default(sent)
  sentAt   DateTime?             @map("sent_at") @db.Timestamptz(3)

  createdBy   Admin   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String @map("created_by") @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  views AnnouncementView[]

  @@index([status, scheduledAt])
  @@index([createdById])
  @@map("announcements")
}

model Task {
  id String @id @db.VarChar(24)

  title       String
  description String?

  priority TaskPriority @default(medium)
  status   TaskStatus   @default(pending)
  dueDate  DateTime?    @map("due_date") @db.Timestamptz(3)

  createdBy   Admin   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String @map("created_by") @db.VarChar(24)

  /// Files the admin attached when assigning the task: [{ url, name }].
  /// Nothing queries an individual attachment, so JSONB rather than a table.
  attachments Json? @default("[]")

  /// Latest admin revision reason; set on "revision" review, cleared on
  /// resubmit or approve.
  revisionReason String? @map("revision_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignees   TaskAssignee[]
  submissions TaskSubmission[]

  @@index([status, dueDate])
  @@index([createdById])
  @@map("tasks")
}

/// Was `Task.assignees: [ObjectId]`. A junction table so the relation is
/// indexable in both directions and enforced by FKs.
model TaskAssignee {
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String @map("task_id") @db.VarChar(24)

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String @map("member_id") @db.VarChar(24)

  @@id([taskId, memberId])
  @@index([memberId])
  @@map("task_assignees")
}

/// Was the embedded `Task.submissions[]` array. A real timeline with an author
/// and a timestamp, so it becomes a table; its own nested `attachments[]` stay
/// JSONB because nothing queries an individual attachment.
model TaskSubmission {
  id String @id @default(uuid())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String @map("task_id") @db.VarChar(24)

  notes String
  link  String?

  attachments Json? @default("[]")

  submittedBy   Member   @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  submittedById String   @map("submitted_by") @db.VarChar(24)
  submittedAt   DateTime @map("submitted_at") @db.Timestamptz(3)

  @@index([taskId, submittedAt])
  @@map("task_submissions")
}

model ActivityLog {
  id      String @id @db.VarChar(24)
  logCode Int    @map("log_code")

  /// The actor is staff, and staff are two tables — an admin or a member can
  /// both log in to the panel. Two nullable FKs rather than one untyped column
  /// so the audit trail keeps referential integrity either way; a CHECK
  /// constraint (see the migration) enforces that exactly one is set.
  actorAdmin   Admin?  @relation("ActivityLogAdminActor", fields: [actorAdminId], references: [id], onDelete: Restrict)
  actorAdminId String? @map("actor_admin_id") @db.VarChar(24)

  actorMember   Member? @relation("ActivityLogMemberActor", fields: [actorMemberId], references: [id], onDelete: Restrict)
  actorMemberId String? @map("actor_member_id") @db.VarChar(24)

  action ActivityLogAction

  /// Polymorphic over five types, write-only audit trail — kept denormalised.
  targetType ActivityLogTargetType? @map("target_type")
  targetId   String?                @map("target_id") @db.VarChar(24)

  details   String?
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([actorAdminId, createdAt(sort: Desc)])
  @@index([actorMemberId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("activity_logs")
}

model EmailLog {
  id      String @id @db.VarChar(24)
  emailId String @unique @map("email_id")

  recipient String

  /// Human-readable code of the record the email is about (shop/listing/
  /// service/job/broadcast code) — not an ObjectId, so no FK.
  relatedRecordId String? @map("related_record_id")

  eventType      EmailLogEvent  @map("event_type")
  deliveryStatus EmailLogStatus @map("delivery_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([eventType, createdAt(sort: Desc)])
  @@index([deliveryStatus])
  @@map("email_logs")
}

/// Fixed string primary key (e.g. "site-settings"), not an ObjectId.
model SiteSettings {
  id String @id @db.VarChar(64)

  facebookUrl String? @map("facebook_url")
  twitterUrl  String? @map("twitter_url")
  threadsUrl  String? @map("threads_url")
  linkedinUrl String? @map("linkedin_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

/// Generic atomic-sequence counter (userCode, shopCode, listingCode, ...).
/// Fixed string primary key, not an ObjectId.
model Counter {
  id  String @id @db.VarChar(64)
  seq Int    @default(0)

  @@map("counters")
}

// =============================================================================
// ENGAGEMENT ANALYTICS
// Dedup tables used as counters: counting rows IS the metric. Views dedup per
// (item, user, day); clicks dedup per (item, user) for all time.
// =============================================================================

model ProductView {
  id String @id @db.VarChar(24)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.VarChar(24)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.VarChar(24)

